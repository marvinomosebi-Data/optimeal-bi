          edge="1" source="rls_fn" target="optimizer" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RLS/fn → Admin BI Dashboard -->
        <mxCell id="a_db_admin" value="REST · @supabase/js (admin JWT)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;strokeWidth=2;fontColor=#7e22ce;fontSize=9;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="rls_fn" target="admin_dash" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
