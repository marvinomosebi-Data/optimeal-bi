          vertex="1" parent="1">
          <mxGeometry x="58" y="65" width="420" height="20" as="geometry" />
        </mxCell>

        <!-- Campus price curation -->
        <mxCell id="campus" value="&lt;b&gt;Campus Price Curation&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Cafeteria menus · food items&lt;br/&gt;portion sizes · base prices&lt;br/&gt;seeded via supabase/seed.sql&lt;/font&gt;"
          style="rounded=2;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#2563eb;fontSize=11;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="120" y="93" width="290" height="123" as="geometry" />
        </mxCell>

        <!-- NBS price submission -->
        <mxCell id="nbs_sub" value="&lt;b&gt;NBS Price Submission&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Monthly Osun State raw-food&lt;br/&gt;market prices submitted by admin&lt;br/&gt;via role-gated Monthly Update form&lt;/font&gt;"
          style="rounded=2;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#2563eb;fontSize=11;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="793" y="93" width="290" height="123" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════ LAYER 2 — DATABASE ═════════ -->
        <mxCell id="L2_bg" value=""
