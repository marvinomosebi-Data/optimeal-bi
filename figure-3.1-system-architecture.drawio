          vertex="1" parent="1">
          <mxGeometry x="40" y="268" width="1120" height="252" as="geometry" />
        </mxCell>
        <mxCell id="L2_hdr" value="LAYER 2 — DATABASE LAYER     (Supabase · PostgreSQL + Auth + Row Level Security)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#7e22ce;"
          vertex="1" parent="1">
          <mxGeometry x="58" y="275" width="800" height="20" as="geometry" />
        </mxCell>

        <!-- ── six tables ── -->
        <mxCell id="t_cafeterias" value="&lt;b&gt;cafeterias&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;id · name · location&lt;br/&gt;code · zone&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d5ff;strokeColor=#9333ea;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="65" y="305" width="158" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t_food_items" value="&lt;b&gt;food_items&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;id · name · category&lt;br/&gt;price · satiety&lt;br/&gt;max_portions&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d5ff;strokeColor=#9333ea;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="237" y="305" width="158" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t_cafe_items" value="&lt;b&gt;cafeteria_items&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;cafe_id · item_id&lt;br/&gt;price overrides&lt;br/&gt;specialty additions&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d5ff;strokeColor=#9333ea;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="409" y="305" width="158" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t_nbs_prices" value="&lt;b&gt;nbs_prices&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;item_name · price_naira&lt;br/&gt;unit · month&lt;br/&gt;year · zone&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d5ff;strokeColor=#9333ea;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="581" y="305" width="158" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t_saved_plans" value="&lt;b&gt;saved_plans&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;user_id · cafe_id&lt;br/&gt;budget · items (jsonb)&lt;br/&gt;satiety_score · plan_name&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d5ff;strokeColor=#9333ea;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="753" y="305" width="158" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t_id_lookup" value="&lt;b&gt;id_lookup&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;id_number (PK)&lt;br/&gt;bowen_email (unique)&lt;br/&gt;user_id (FK → auth.users)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d5ff;strokeColor=#9333ea;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="925" y="305" width="158" height="80" as="geometry" />
        </mxCell>

        <!-- ── RLS + function note ── -->
        <mxCell id="rls_fn" value="&lt;b&gt;Row Level Security (RLS)&lt;/b&gt;  ·  public SELECT on cafeterias / food_items / cafeteria_items / nbs_prices  ·  admin INSERT on nbs_prices  ·  admin UPDATE on food_items / cafeteria_items  ·  owner-scoped SELECT / INSERT / DELETE on saved_plans  ·  public SELECT + INSERT on id_lookup (pre-auth)&lt;br/&gt;&lt;b&gt;menu_for_cafeteria(cafe_id)&lt;/b&gt;  SQL function — merges food_items with per-cafeteria price overrides and specialty additions via UNION"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7e22ce;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=8;dashed=1;strokeWidth=1.5;"
          vertex="1" parent="1">
          <mxGeometry x="65" y="400" width="1018" height="100" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════ LAYER 3 — APPLICATION ══════ -->
        <mxCell id="L3_bg" value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="552" width="1120" height="220" as="geometry" />
        </mxCell>
        <mxCell id="L3_hdr" value="LAYER 3 — APPLICATION LAYER     (React 19 + Vite 8 PWA · Deployed via GitHub → Vercel)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#15803d;"
          vertex="1" parent="1">
          <mxGeometry x="58" y="559" width="750" height="20" as="geometry" />
        </mxCell>

        <!-- Student Meal Optimizer -->
        <mxCell id="optimizer" value="&lt;b&gt;Student Meal Optimizer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Client-side Bounded Knapsack engine&lt;br/&gt;(src/lib/optimizer.js)&lt;br/&gt;Budget · Appetite · Crave / Avoid&lt;br/&gt;Manual portion override&lt;br/&gt;Save to Favourites&lt;/font&gt;"
          style="rounded=2;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontSize=11;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="585" width="300" height="157" as="geometry" />
        </mxCell>

        <!-- Admin BI Dashboard -->
        <mxCell id="admin_dash" value="&lt;b&gt;Admin BI Dashboard&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Recharts price-trend visualisations&lt;br/&gt;Volatility rankings&lt;br/&gt;Monthly NBS Reference Update form&lt;br/&gt;Role-gated (JWT user_metadata.role)&lt;/font&gt;"
          style="rounded=2;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontSize=11;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="450" y="585" width="300" height="157" as="geometry" />
        </mxCell>

        <!-- Auth & Deployment -->
        <mxCell id="auth_deploy" value="&lt;b&gt;Auth &amp; Deployment&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Supabase Auth (bowen.edu.ng email)&lt;br/&gt;ID-based login via id_lookup&lt;br/&gt;Guest mode (no account needed)&lt;br/&gt;GitHub → Vercel auto-deploy&lt;br/&gt;SPA rewrite (vercel.json)&lt;/font&gt;"
          style="rounded=2;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontSize=11;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="810" y="585" width="300" height="157" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════ ARROWS ═════════ -->

        <!-- Campus price curation → food_items (seed data) -->
        <mxCell id="a_campus_food" value="seed.sql"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1d4ed8;fontSize=9;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="campus" target="t_food_items" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- NBS submission → nbs_prices (INSERT via admin RLS) -->
        <mxCell id="a_nbs_prices" value="INSERT (admin RLS)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1d4ed8;fontSize=9;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="nbs_sub" target="t_nbs_prices" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RLS/fn → Student Optimizer -->
        <mxCell id="a_db_optimizer" value="REST · @supabase/js (anon key)"
