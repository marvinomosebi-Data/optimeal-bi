          vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="1120" height="36" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════ LAYER 1 — DATA SOURCE ══════ -->
        <mxCell id="L1_bg" value=""
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1120" height="178" as="geometry" />
        </mxCell>
        <mxCell id="L1_hdr" value="LAYER 1 — DATA SOURCE LAYER"
